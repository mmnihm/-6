# Telegram Bot
BOT_TOKEN=123456:REPLACE_ME
API_ID=123456
API_HASH=REPLACE_ME
BOT_USERNAME=your_bot_username

# Telegram IDs: use -100... for channels and supergroups
MEMBER_GROUP_ID=-1001234567890
STORAGE_CHANNEL_ID=-1001234567891
BACKUP_CHANNEL_ID=-1001234567892

# Local persistent storage
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO
